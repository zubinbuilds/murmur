# Copy to .env (setup.sh does this). .env is git-ignored: never commit keys.

# Speech to text. Pick one with MURMUR_STT, or switch in the web UI.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
MURMUR_STT=elevenlabs          # elevenlabs | deepgram | pipecat | mock (mock needs no key)

# The band: the number on its bag (82 = Vexo-HACK-82).
MURMUR_BAND=82
MURMUR_TRANSPORT=ble           # ble | sim | mic (sim replays a sample recording, no hardware)
MURMUR_WHISPER_ONLY=1          # 1: only whispers reach the speech service; voices speaking aloud are dropped
MURMUR_RECORD=0                # 1: save the raw band audio to recordings/ (same as --record)
MURMUR_OWN_VOICE=off           # off | motion: a turn needs the band's accelerometer to feel you speak

# Instinct, over iMessage: the phone number or Apple ID email you text to reach it.
INSTINCT_IMESSAGE_TO=
# 1 = show what would be sent, send nothing. Set to 0 only when you mean it.
MURMUR_DRY_RUN=1

# Wake phrase is "Hey <alias>". Comma-separated spellings the recogniser may produce.
MURMUR_WAKE_ALIASES=murmur,murmurs,murmer

# Deepgram (deepgram and pipecat engines): words and phrases to recognise more readily, comma-separated.
# A phrase can have spaces. Keep it short: Deepgram allows 500 tokens in total.
MURMUR_KEYTERMS=Murmur

# Band tuning
MURMUR_MIC_GAIN_DB=20          # -20 to +20 dB; +20 is the kit default and the maximum
MURMUR_TOGGLE_GESTURE=double-tap   # tap | double-tap | none
MURMUR_TAP_THRESHOLD=1.2

# Whisper gate (calibrate in the UI rather than guessing these)
MURMUR_GATE_THRESHOLD_DB=-45
MURMUR_GATE_MARGIN_DB=14
MURMUR_TURN_SILENCE_MS=700

# Microphone instead of the band (MURMUR_TRANSPORT=mic): input device name; empty = system default.
MURMUR_MIC_DEVICE=

# The band over its USB cable (MURMUR_TRANSPORT=serial or --usb): port name; empty = found automatically.
MURMUR_SERIAL_PORT=

# Gemini 4: tidies each command before it is acted on, or answers it here with MURMUR_AGENT=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
MURMUR_AGENT=instinct          # instinct | gemini
MURMUR_CLEANUP=1

# Speak replies aloud on this output device (empty = off).
MURMUR_VOICE_DEVICE=
MURMUR_TTS=elevenlabs          # elevenlabs | deepgram
ELEVENLABS_VOICE_ID=           # empty = the first voice in your ElevenLabs library
