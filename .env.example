# Copy to .env (setup.sh does this). .env is git-ignored: never commit keys.

# Speech to text. Pick one with VOCAL_STT, or switch in the web UI.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
VOCAL_STT=elevenlabs          # elevenlabs | deepgram | mock (mock needs no key)

# The band: the number on its bag (82 = Vexo-HACK-82).
VOCAL_BAND=82
VOCAL_TRANSPORT=ble           # ble | sim (sim replays a sample recording, no hardware)

# Instinct, over iMessage: the phone number or Apple ID email you text to reach it.
INSTINCT_IMESSAGE_TO=
# 1 = show what would be sent, send nothing. Set to 0 only when you mean it.
VOCAL_DRY_RUN=1

# Wake phrase is "Hey <alias>". Comma-separated spellings the recogniser may produce.
VOCAL_WAKE_ALIASES=vocal,vocals

# Band tuning
VOCAL_MIC_GAIN_DB=20          # -20 to +20 dB; +20 is the kit default and the maximum
VOCAL_TOGGLE_GESTURE=double-tap   # tap | double-tap | none
VOCAL_TAP_THRESHOLD=1.2

# Whisper gate (calibrate in the UI rather than guessing these)
VOCAL_GATE_THRESHOLD_DB=-45
VOCAL_GATE_MARGIN_DB=10
VOCAL_TURN_SILENCE_MS=700
